# Configuración de las fuentes diarias RNPDNO y PUI.
# Copia este archivo a `.secrets/drive.env` y llena los identificadores.
#
#     cp .secrets/drive.env.ejemplo .secrets/drive.env
#
# Se requiere además `.secrets/oauth_client.json` para usar Drive.
# Ver docs/9_credenciales_google_drive.md.

# Carpeta de Drive que contiene `reporte_personas_completo.parquet`.
# Acepta el id pelón o la URL completa de la carpeta.
GDRIVE_RNPDNO_FOLDER_ID=

# Pon 0 para trabajar sólo con el archivo local configurado para RNPDNO.
GDRIVE_RNPDNO_HABILITADO=1

# Carpeta de Drive con los ZIP diarios de la PUI.
GDRIVE_PUI_FOLDER_ID=

# Pon 0 para trabajar sólo con el archivo local configurado para PUI.
GDRIVE_PUI_HABILITADO=1

# Opcional: descomenta para usar archivos locales en ambas fuentes.
#PIPELINE_MODO_INSUMOS=local
#PIPELINE_RNPDNO_ARCHIVO=input/rnpdno/reporte_personas_completo_DDMMAAAA.parquet
#PIPELINE_PUI_ARCHIVO=input/pui/reporte_coincidencias_validas_YYYY-MM-DD.csv
