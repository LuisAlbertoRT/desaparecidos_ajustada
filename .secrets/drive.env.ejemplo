# Configuración de la descarga automática desde Google Drive.
# Copia este archivo a `.secrets/drive.env` y llena los valores.
#
#     cp .secrets/drive.env.ejemplo .secrets/drive.env
#
# Lo lee config.py con python-dotenv. Ver .secrets/README.md.

# Carpeta de Drive que contiene los `reporte_personas_completo_DDMMAAAA.parquet`.
# Acepta el id pelón o la URL completa de la carpeta.
GDRIVE_RNPDNO_FOLDER_ID=

# Llave de la cuenta de servicio. Ruta relativa a la raíz del proyecto o absoluta.
# Si se deja vacío se usa `.secrets/service_account.json`.
GDRIVE_SERVICE_ACCOUNT_JSON=

# Pon 0 para apagar la descarga y trabajar sólo con lo que ya está en input/rnpdno/.
GDRIVE_RNPDNO_HABILITADO=1
